# Copy to `.env.local` (git-ignored, same pattern as apps/web) for local dev.
# `EXPO_PUBLIC_` values are inlined into the JS bundle. Both this key and the
# Supabase pair below are required — there is no mocked fallback.

# Every user's generation calls go through this one key (no per-user
# bring-your-own-key path).
EXPO_PUBLIC_OPENROUTER_API_KEY=

# Supabase for real accounts + cross-device deck sync. The anon key is safe to
# ship in the bundle (locked down by Row Level Security).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
