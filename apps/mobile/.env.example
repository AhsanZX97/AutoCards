# Copy to `.env.local` (git-ignored, same pattern as apps/web) for local dev.
# `EXPO_PUBLIC_` values are inlined into the JS bundle. The Supabase pair is
# required; there is no mocked fallback.

# Supabase for real accounts, cross-device deck sync, and card generation. The
# anon key is safe to ship in the bundle (locked down by Row Level Security).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PostHog product analytics. These public values are inlined into the JS bundle.
EXPO_PUBLIC_POSTHOG_KEY=your_posthog_project_token
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# There is deliberately no OpenRouter key here. Anything inlined into the
# bundle can be read out of a shipped app, which would make the monthly upload
# allowance unenforceable. The key belongs to the `generate-deck` Edge
# Function. See supabase/functions/README.md.
