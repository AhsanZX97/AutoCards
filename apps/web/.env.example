# Copy to `.env.local` (git-ignored). The Supabase pair is required; there is
# no mocked fallback.

# Supabase for real accounts, cross-device deck sync, and card generation. The
# anon key is safe to ship in the bundle (it's locked down by Row Level
# Security); the URL is public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Where the Edge Functions that generate cards are served from, when
# that is not the project URL above. Set it to http://localhost:54321 to run
# `supabase functions serve` locally against the hosted database.
VITE_SUPABASE_FUNCTIONS_URL=

# There is deliberately no OpenRouter key here. Vite inlines every VITE_ value
# into the bundle, so a key in this file is readable by anyone who loads the
# app, which would leave an upload allowance nobody can enforce. The key
# belongs to the `generate-deck` function:
#
#   npx supabase secrets set OPENROUTER_API_KEY=sk-or-...
#
# See supabase/functions/README.md.
